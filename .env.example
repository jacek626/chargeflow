# ChargeFlow — Local Development Environment Variables
#
# Copy this file to .env for local development (never commit .env):
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT values only.
# NEVER use these credentials in a real AWS environment.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=chargeflow
POSTGRES_USER=chargeflow
POSTGRES_PASSWORD=chargeflow_local

# ─── Charging Session Service datasource ─────────────────────────────────────
# Maps to spring.datasource.* via application.yml environment variable placeholders
DB_URL=jdbc:postgresql://localhost:5432/chargeflow
DB_USERNAME=chargeflow
DB_PASSWORD=chargeflow_local

# ─── LocalStack / AWS (dummy local values — NOT real AWS credentials) ────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
